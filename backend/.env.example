# Copia este archivo a .env y ajusta los valores:
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (Linux/macOS)

# JWT
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRY_HOURS=24
# * = cualquier origen (útil en LAN). En producción pública usa URLs concretas separadas por coma.
CORS_ORIGINS=*

# MySQL (recomendado). Si MYSQL_DATABASE está vacío, usa SQLite en ../data/app.db
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=tutor

# URL completa (tiene prioridad sobre MYSQL_*)
# DATABASE_URL=mysql+pymysql://usuario:password@127.0.0.1:3306/tutor?charset=utf8mb4

# Ollama (modelos de IA locales)
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_LLM_MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text